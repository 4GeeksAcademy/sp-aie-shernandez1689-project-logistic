# TrackFlow Operations API — variables de entorno
# Copia este archivo a .env y ajusta los valores.

# JWT compartido con user-api (firma de tokens emitidos por el servicio de auth)
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Telemetría (Fase 1 — endpoint stub temporal).
# URL del endpoint de destino para la Fase 3 (persistencia en Supabase).
# Todavía NO se usa para redirigir tráfico: solo se lee en el arranque para
# establecer el patrón de configuración.
TELEMETRY_ENDPOINT=
# Checkpointer del agente LangGraph (data/pipelines/checkpointer.py).
# postgres | sqlite | memory. Vacío: postgres si hay AGENT_CHECKPOINT_DB_URL o
# DATABASE_URL, si no sqlite. "memory" solo en desarrollo local.
AGENT_CHECKPOINTER=
# Postgres (por defecto usa DATABASE_URL). Con el pooler de Supabase funciona
# en modo transacción (sin prepared statements).
AGENT_CHECKPOINT_DB_URL=
AGENT_CHECKPOINT_POOL_SIZE=5
# SQLite (por defecto data/checkpoints/agent_checkpoints.sqlite)
AGENT_CHECKPOINT_SQLITE_PATH=

# RFP Parte 3 (aprobación por departamento, data/pipelines/rfp_intake/approval.py).
# Abrir la aprobación al terminar la Parte 2 (1 por defecto).
RFP_AUTO_APPROVAL=1
# Rondas de request_changes por sección y rondas de arbitraje por ticket.
RFP_MAX_APPROVAL_ROUNDS=3
RFP_MAX_ARBITRATION_ROUNDS=3
