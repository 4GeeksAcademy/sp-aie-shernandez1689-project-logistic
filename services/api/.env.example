# TrackFlow Operations API — variables de entorno
# Copia este archivo a .env y ajusta los valores.

# JWT compartido con user-api (firma de tokens emitidos por el servicio de auth)
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Telemetría (Fase 1 — endpoint stub temporal).
# URL del endpoint de destino para la Fase 3 (persistencia en Supabase).
# Todavía NO se usa para redirigir tráfico: solo se lee en el arranque para
# establecer el patrón de configuración.
TELEMETRY_ENDPOINT=