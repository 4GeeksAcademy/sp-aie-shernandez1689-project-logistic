# ---------------------------------------------------------------------------
# TrackFlow MCP Server — Environment Configuration
# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the values.
#
#   cp .env.example .env
#
# All variables have sensible defaults except JWT_SECRET_KEY.
# ---------------------------------------------------------------------------

# (REQUIRED) Symmetric key shared with services/user-api for JWT verification.
# Must match exactly the JWT_SECRET_KEY in services/user-api/.env
JWT_SECRET_KEY="change-me-to-a-real-secret"

# URL of the TrackFlow Operations API (incidents manager).
API_BASE_URL="http://127.0.0.1:8000"

# URL of the TrackFlow User API (inventory service).
INVENTORY_API_BASE_URL="http://127.0.0.1:8001"

# MCP Server resource identifier (RFC 8707) — expected `aud` claim.
MCP_RESOURCE_ID="https://mcp.trackflow.dev"

# Authorisation server issuer — expected `iss` claim.
MCP_ISSUER="http://127.0.0.1:8001"

# Host and port for the MCP server (SSE transport).
HOST="0.0.0.0"
PORT=8100
